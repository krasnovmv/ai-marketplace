{
  "marketplace": {
    "name": "ai-marketplace",
    "owner": { "name": "krasnovmv" }
  },
  "sources": [
    {
      "id": "ponytail",
      "type": "marketplace",
      "repository": "DietrichGebert/ponytail",
      "branch": "main",
      "selection": "all"
    },
    {
      "id": "mattpocock",
      "type": "marketplace",
      "repository": "mattpocock/skills",
      "branch": "main",
      "selection": "all"
    },
    {
      "id": "superpowers",
      "type": "repository",
      "repository": "obra/superpowers",
      "branch": "main",
      "selection": "selected",
      "plugins": [
        { "name": "superpowers", "path": "." }
      ]
    },
    {
      "id": "anthropic-official",
      "type": "marketplace",
      "repository": "anthropics/claude-plugins-official",
      "branch": "main",
      "selection": "selected",
      "plugins": [
        { "name": "typescript-lsp" }
      ]
    },
    {
      "id": "anthropic-knowledge-work",
      "type": "marketplace",
      "repository": "anthropics/knowledge-work-plugins",
      "branch": "main",
      "selection": "selected",
      "plugins": [
        { "name": "engineering" },
        { "name": "design" },
        { "name": "data" },
        { "name": "productivity" }
      ]
    },
    {
      "id": "ru-text",
      "type": "repository",
      "repository": "talkstream/ru-text",
      "branch": "main",
      "selection": "selected",
      "plugins": [
        { "name": "ru-text", "path": "." }
      ]
    },
    {
      "id": "claude-codex-settings",
      "type": "repository",
      "repository": "fcakyon/claude-codex-settings",
      "branch": "main",
      "selection": "selected",
      "plugins": [
        { "name": "simplify", "path": "plugins/simplify" }
      ]
    },
    {
      "id": "universal-modder",
      "type": "repository",
      "repository": "rehan-remade/universal-modder",
      "branch": "main",
      "selection": "selected",
      "plugins": [
        { "name": "universal-modder", "path": "." }
      ]
    }
  ],
  "limits": { "maxFileSizeMb": 7, "maxPluginSizeMb": 50 },
  "omit": {
    "engineering": [".mcp.json"],
    "design": [".mcp.json"],
    "data": [".mcp.json"],
    "productivity": [".mcp.json"],
    "ponytail": [
      "assets/**",
      "!assets/codex-icon.png",
      "!assets/logo.png"
    ],
    "universal-modder": [
      "docs/media/**",
      "!docs/media/logo-128.png",
      "!docs/media/logo.png"
    ]
  }
}
